# 服务基础配置
PORT=9100
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_chars
# 开发调试开关：true 时验证码随 /api/auth/sms/send 接口响应直接返回，生产环境请务必置为 false
SMS_DEBUG_RETURN_CODE=true

# MySQL 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=voice
DB_PASSWORD=your_mysql_password
DB_NAME=voice_gateway

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 阿里云短信认证 (生产环境调用 Dysmsapi)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 支付宝电脑网站支付 / Vibe Pay 基础配置
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.yourdomain.com/pay/alipay/notify
ALIPAY_RETURN_URL=https://api.yourdomain.com/pay/result

