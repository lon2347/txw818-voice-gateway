# 服务基础配置
PORT=9100
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_32_chars
# 开发调试开关：true 时验证码随 /api/auth/sms/send 接口响应直接返回（两种通道都适用：
# dypnsapi 靠 ReturnVerifyCode=true 取回阿里云生成的码），生产环境请务必置为 false
SMS_DEBUG_RETURN_CODE=true

# MySQL 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_USER=voice
DB_PASSWORD=your_mysql_password
DB_NAME=voice_gateway

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ================= 阿里云短信 =================
# 二选一，留空则不真正发短信（仅 SMS_DEBUG_RETURN_CODE=true 时把验证码回传前端供联调）：
#   dypnsapi = 号码认证服务·短信认证（个人开发者可用，用控制台赠送的签名+模板，验证码由阿里云生成并核验）
#   dysmsapi = 短信服务（需资质/签名/模板审核通过，验证码由我们自己生成并比对）
SMS_PROVIDER=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# dypnsapi：赠送签名名称（如：恒创联众）+ 赠送模板 CODE（纯数字，如：100001）
# dysmsapi：审核通过的签名名称 + 模板 CODE（如：SMS_123456789，模板变量必须叫 code）
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 仅 dypnsapi：认证方案名称，留空用“默认方案”；发送与核验必须一致
ALIYUN_SMS_SCHEME_NAME=
# 仅 dypnsapi：模板占位符 JSON，留空则用 {"code":"##code##","min":"5"}。
# 必须与赠送模板里的变量名一字不差，多传/少传都会报 INVALID_PARAMETERS
ALIYUN_SMS_TEMPLATE_PARAM_JSON=
# 仅 dypnsapi：验证码位数 4~8 / 有效期秒 / 同号重发间隔秒；CodeType 1=纯数字
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_TIME=300
ALIYUN_SMS_INTERVAL=60
ALIYUN_SMS_CODE_TYPE=1
# 域名留空即按 SMS_PROVIDER 自动取 dypnsapi.aliyuncs.com / dysmsapi.aliyuncs.com
ALIYUN_SMS_ENDPOINT=
ALIYUN_SMS_REGION=cn-hangzhou

# 支付宝电脑网站支付 / Vibe Pay 基础配置
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.yourdomain.com/pay/alipay/notify
ALIPAY_RETURN_URL=https://api.yourdomain.com/pay/result

